            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>AutotransConnectorMedium</SubtypeId>
            </Id>
            <Size x="0" y="0" z="1" />
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>AutotransLargeBlockInsetConnector</SubtypeId>
            </Id>
            <Size x="0" y="0" z="1" />
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>AutotransLargeBlockInsetConnectorSmall</SubtypeId>
