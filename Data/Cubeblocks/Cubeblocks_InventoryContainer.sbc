                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransConnectorSmall" ForceCreate="true"/>
            </DefaultComponents>
        </Container>

        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
                <SubtypeId>AutotransConnectorMedium</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransConnectorMedium" ForceCreate="true"/>
            </DefaultComponents>
        </Container>
        
        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
                <SubtypeId>AutotransLargeBlockInsetConnector</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransLargeBlockInsetConnector" ForceCreate="true"/>
            </DefaultComponents>
        </Container>
        
        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
                <SubtypeId>AutotransLargeBlockInsetConnectorSmall</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransLargeBlockInsetConnectorSmall" ForceCreate="true"/>
