<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    
    <EntityContainers>
        
        <Container>
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>AutotransZoneContainer</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransZoneContainer" ForceCreate="true"/>
            </DefaultComponents>
        </Container>

        <Container>
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>AutotransLargeBlockLargeContainer</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransLargeBlockLargeContainer" ForceCreate="true"/>
            </DefaultComponents>
        </Container>

        <Container>
            <Id>
                <TypeId>CargoContainer</TypeId>
                <SubtypeId>AutotransLargeBlockLargeIndustrialContainer</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransLargeBlockLargeIndustrialContainer" ForceCreate="true"/>
            </DefaultComponents>
        </Container>

        <!--Connector-->
        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
                <SubtypeId>AutotransConnector</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransConnector" ForceCreate="true"/>
            </DefaultComponents>
        </Container>

        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
