            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransSmallBlockInsetConnector" ForceCreate="true"/>
            </DefaultComponents>
        </Container>
        
        <Container>
            <Id>
                <TypeId>ShipConnector</TypeId>
                <SubtypeId>AutotransSmallBlockInsetConnectorMedium</SubtypeId>
            </Id>
            <DefaultComponents>
                <Component BuilderType="MyObjectBuilder_Inventory" SubtypeId="AutotransSmallBlockInsetConnectorMedium" ForceCreate="true"/>
            </DefaultComponents>
        </Container>
        
    </EntityContainers>

    <EntityComponents>

        <!--Connector-->
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>AutotransConnector</SubtypeId>
            </Id>
            <Size x="0" y="0" z="1" />
